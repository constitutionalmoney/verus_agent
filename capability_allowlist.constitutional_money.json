{
  "profile": "constitutional_money",
  "description": "Read-only discovery profile for Constitutional Money development. Membership is not human approval.",
  "policy": {
    "generic_verus_operations_default": "deny",
    "intended_use": "Read-only identity, ledger, and estimate verification before any separately reviewed activation."
  },
  "allowed_capabilities": [
    "verus.cli.execute",
    "verus.identity.get",
    "verus.currency.estimate",
    "verus.storage.retrieve",
    "verus.storage.retrieve_data_wrapper",
    "verus.login.authenticate",
    "verus.login.validate"
  ],
  "allowed_cli_methods": [
    "getinfo",
    "getblockcount",
    "getidentity",
    "getidentitycontent",
    "getcurrencystate",
    "estimateconversion",
    "z_getoperationstatus"
  ],
  "domain_groups": {
    "future_issuance_operations": {
      "status": "blocked_pending_testnet_write_activation_and_per-mutation_approval",
      "capabilities": [
        "verus.identity.create",
        "verus.identity.update",
        "verus.identity.vault",
        "verus.currency.send",
        "verus.currency.estimate"
      ],
      "notes": [
        "These capabilities are documented future scope and are not allowlisted here.",
        "Activation requires a project contract, exact task approval, idempotency outbox, confirmation, and readback."
      ]
    },
    "future_redemption_operations": {
      "status": "blocked_pending_testnet_write_activation_and_per-mutation_approval",
      "capabilities": [
        "verus.currency.send",
        "verus.storage.store",
        "verus.storage.retrieve",
        "verus.storage.store_data_wrapper",
        "verus.storage.retrieve_data_wrapper"
      ],
      "notes": [
        "These capabilities are documented future scope and are not allowlisted here.",
        "No real participant, wallet, or redemption data may be used during development."
      ]
    },
    "generic_verus_operations": {
      "default_policy": "deny",
      "examples_not_allowed": [
        "verus.marketplace.*",
        "verus.ip.*",
        "verus.mobile.login_consent",
        "verus.mobile.purchase_link",
        "verus.defi.*",
        "verus.market.monitor",
        "verus.bridge.cross"
      ]
    }
  }
}
